URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
INTELX_API_KEY=
HIBP_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
IPINFO_TOKEN=
NUM_API_KEY=
FLASK_SECRET_KEY=xaxglog-change-me-in-prod
# Bootstrap admin user (created on first run if no admin exists)
XAXGLOG_ADMIN_PASSWORD=xaxglog-admin
# Authorized SS7 carrier lawful-access gateway (leave empty -> export for manual submission)
SS7_GATEWAY_ENDPOINT=
SS7_GATEWAY_TOKEN=
# Authorized vehicle-data provider (reverse-plate / registration; leave empty -> export for manual submission)
VEHICLE_GATEWAY_ENDPOINT=
VEHICLE_GATEWAY_TOKEN=
# OpenCorporates API token (optional; Wikidata fallback works with no key)
OC_API_KEY=
# UK Companies House (free key; leave empty -> GLEIF/Wikidata only)
CH_API_KEY=
# Mapillary street-level imagery (free token; leave empty -> OSM-only)
MAPILLARY_CLIENT_TOKEN=
# --- Part 1 + Part 2 optional keys (all modules run keyless without them) ---
# Wi-Fi/cell geolocation (free account -> Basic auth token; empty -> mylnikov keyless)
WIGLE_BASIC_AUTH=
# MarineTraffic AIS vessel search (free tier; empty -> MMSI decode + GDELT news only)
MARINETRAFFIC_API_KEY=
# FEC campaign-filings API (free key at api.usa.gov; empty -> directory only)
FEC_API_KEY=
# Meta Ads Library archive API (Graph token; empty -> Google transparency links only)
META_ACCESS_TOKEN=
# OpenSea account/NFT intel (free key; empty -> federated search only)
OPENSEA_API_KEY=
# PhishTank verified-feed access token (optional; anonymous feed works slower)
PHTANK_API_KEY=
# Local YARA rules directory for malintel/yara (empty -> yara endpoint reports unavailable)
YARA_RULES_DIR=
# browserrender page-capture timeout seconds (selenium must be installed separately)
BROWSERRENDER_TIMEOUT=25
# "1" = enable bulk sanctions-name index download (large); default keyless lists only
OPENSANCTIONS_BULK=0
PORT=5000
HOST=127.0.0.1
COLLECT_INTERVAL_HOURS=12
TOOL_TIMEOUT=300
HTTP_TIMEOUT=12
FLASK_DEBUG=0
# --- Part 6 optional keys (image reverse runs keyless Trace.moe without them) ---
# SauceNAO API key (optional; link-out works without a key)
XAXGLOG_SAUCENAO_KEY=
# TinEye API key (optional; link-out works without a key)
XAXGLOG_TINEYE_KEY=
# Google Vision API key (optional; WEB_DETECTION labels only)
XAXGLOG_GOOGLE_VISION_KEY=
